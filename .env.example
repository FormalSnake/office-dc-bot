DISCORD_TOKEN=
# Registers slash commands per guild (instant) instead of globally (up to an hour).
DISCORD_GUILD_ID=
# Public address players connect to; also used for the mcsrvstat.us fallback.
MINECRAFT_SERVER=office.kaiiserni.com

# RCON gives live player lists, tick health, /console, /whitelist and /say.
# Without it the bot only shows the cached public status.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# The server's data directory (itzg /data) mounted read-only. Gives the log
# (chat, deaths, advancements, joins posted with player heads) and the
# per-player statistics behind /stats.
MC_DATA_PATH=

# Optional links shown as buttons.
BLUEMAP_URL=
MODPACK_URL=

# Set to 1 once the Message Content intent is enabled in the developer portal.
# Turns on the console relay (plain messages in the console channel run as
# commands) and the chat relay (messages in the chat channel go in-game).
MESSAGE_CONTENT=0

# Where bot.sqlite (channel and role settings) lives. The Dockerfile sets /app/data.
DATA_DIR=./data
